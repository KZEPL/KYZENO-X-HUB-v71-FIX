local function getPing()
    local success, result = pcall(function()
        local stats = game:GetService("Stats")
        if stats then
            local data = stats:FindFirstChild("Data")
            if data then
                local ping = data:FindFirstChild("Ping")
                if ping then
                    return math.floor(ping.Value * 1000)
                end
            end
        end
        return 0
    end)
    if success then
        return result or 0
    end
    return 0
end

