local function loadConfigsFromDisk()
    if isfile and readfile then
        local success, data = pcall(function() return readfile("KyzenoX_v7.json") end)
        if success and data and #data > 0 then
            local parsed = HttpService:JSONDecode(data)
            if type(parsed) == "table" then configs = parsed end
        end
    end
end

local function saveConfigsToDisk()
    if writefile then
        local data = HttpService:JSONEncode(configs)
        pcall(function() writefile("KyzenoX_v7.json", data) end)
    end
end

loadConfigsFromDisk()

local function saveAutoSync()
    local configData = {}
    for key, val in pairs(settings) do
        if type(val) ~= "function" and type(val) ~= "thread" and type(val) ~= "userdata" then
            configData[key] = val
        end
    end
    configs["__autosync__"] = configData
    saveConfigsToDisk()
end

local function loadAutoSync()
    if not configs["__autosync__"] then return false end
    local data = configs["__autosync__"]
    for key, val in pairs(data) do
        if settings[key] ~= nil then settings[key] = val end
    end
    return true
end

