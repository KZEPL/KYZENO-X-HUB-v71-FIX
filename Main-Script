local function randomizeAllPlayerNames()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if not originalPlayerNames[p] then
                originalPlayerNames[p] = {Name = p.Name, DisplayName = p.DisplayName}
            end
            local randomName = "Player_" .. math.random(1000, 9999)
            pcall(function()
                p.Name = randomName
                p.DisplayName = randomName
            end)
        end
    end
end

local function restoreAllPlayerNames()
    for p, names in pairs(originalPlayerNames) do
        pcall(function()
            if p and p.Parent then
                p.Name = names.Name
                p.DisplayName = names.DisplayName
            end
        end)
    end
    originalPlayerNames = {}
end

local function setupNameTracking()
    Players.PlayerAdded:Connect(function(p)
        if p ~= player then
            originalPlayerNames[p] = {Name = p.Name, DisplayName = p.DisplayName}
            if settings.streamerMode or settings.anonymous or settings.guestMode then
