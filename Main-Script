                        espTracers[p].From = screenCenter
                        espTracers[p].To = Vector2.new(hrpPos.X, hrpPos.Y)
                        espTracers[p].Visible = true
                    elseif espTracers[p] then
                        espTracers[p].Visible = false
                    end
                end
            end
        end
    end)
end

