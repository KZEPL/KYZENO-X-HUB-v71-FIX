local function formatPlayTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%dh %dmin %ds", h, m, s)
end


local function isAlly(targetPlayer)
    if not targetPlayer or targetPlayer == player then return false end
    local myTeam = player.Team
    local targetTeam = targetPlayer.Team
    if myTeam and targetTeam and myTeam == targetTeam then return true end
    return false
end

local function getOverrideName(p)
    if settings.guestMode then
        return "Guest_" .. string.format("%04d", (p.UserId % 9999) + 1)
    elseif settings.streamerMode then
        return "KYZENO" .. string.format("%03d", (p.UserId % 999) + 1)
    elseif settings.anonymous then
        return "User_" .. string.format("%04d", (p.UserId % 9999) + 1)
    end
    return p.DisplayName
end

-- ============================================================
--  NPC TARGET HELPER & WALL HELPER
-- ============================================================
local function isTargetInFov(targetPosition)
    if not settings.fovCircleEnabled then return true end
    local cam = workspace.CurrentCamera
    local screenPos, onScreen = cam:WorldToViewportPoint(targetPosition)
    if not onScreen then return false end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
    return distance <= settings.fovCircleSize
end

local function isTargetInFront(targetPosition)
    local cam = workspace.CurrentCamera
    local direction = (targetPosition - cam.CFrame.Position).Unit
    local dot = cam.CFrame.LookVector:Dot(direction)
    return dot > 0.2
end

-- ============================================================
--  SHOULD TARGET PLAYER (AIM HELPER LOGIC - ONLY ONE VERSION)
-- ============================================================
local function shouldTargetPlayer(p)
    if not p or p == player then return false end
    if not p.Character then return false end
    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
    local hum = p.Character:FindFirstChild("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end
    
    -- TEAM HELPER MODE
    if settings.teamHelperMode == "No aim at team" then
        if isAlly(p) then return false end
    end
    if settings.teamHelperMode == "Only target enemies" then
        if isAlly(p) then return false end
    end
    if settings.teamCheck and isAlly(p) then return false end
    
    -- Range check
    local myHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false end
    local dist = (myHRP.Position - hrp.Position).Magnitude
    if dist > settings.aimRange then return false end
    
    -- AIM HELPER MODE
    if settings.aimHelperMode == "Within Fov + Range" then
        if not isTargetInFov(hrp.Position) then return false end
    end
    if settings.aimHelperMode == "Infront" then
        if not isTargetInFront(hrp.Position) then return false end
    end
    
    -- NPC HELPER MODE (Extra)
    if settings.npcHelperMode == "Within Fov in Range" then
        if not isTargetInFov(hrp.Position) then return false end
    end
    if settings.npcHelperMode == "Infront" then
        if not isTargetInFront(hrp.Position) then return false end
    end
    
    -- WALL CHECK MODE (Extra)
    if settings.wallHelperMode == "Ignore behind wall in Range" then
        if not isVisibleFromCamera(p.Character, p.Character) then return false end
    end
    if settings.wallHelperMode == "Only visible in fov" then
        if not isTargetInFov(hrp.Position) then return false end
        if not isVisibleFromCamera(p.Character, p.Character) then return false end
    end
    
    -- Default Wall Check
    if settings.ignoreWall == false and settings.wallHelperMode == "Default" then
        if not isVisibleFromCamera(p.Character, p.Character) then return false end
    end
    
    return true
end

