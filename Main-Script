local function isPlayerOnScreen(playerChar)
    if not playerChar then return false end
    local hrp = playerChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local cam = workspace.CurrentCamera
    local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
    if not onScreen then return false end
    if screenPos.X < 0 or screenPos.X > cam.ViewportSize.X then return false end
    if screenPos.Y < 0 or screenPos.Y > cam.ViewportSize.Y then return false end
    local cameraCF = cam.CFrame
    local toTarget = (hrp.Position - cameraCF.Position).Unit
    if cameraCF.LookVector:Dot(toTarget) < 0 then return false end
    return true
end

local function isVisibleFromCamera(targetChar, ignoreCharacter)
    if settings.ignoreWall then return true end
    local cam = workspace.CurrentCamera
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {ignoreCharacter, player.Character}
    local partsToCheck = {"Head", "HumanoidRootPart"}
    for _, partName in ipairs(partsToCheck) do
        local part = targetChar:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local origin = cam.CFrame.Position
            local direction = (part.Position - origin)
            local distance = direction.Magnitude
            local result = Workspace:Raycast(origin, direction.Unit * distance, raycastParams)
            if not result then return true end
            local hitChar = result.Instance:FindFirstAncestorOfClass("Model")
            if hitChar == ignoreCharacter then return true end
        end
    end
    return false
end

local function isESPVisible(p)
    if not settings.espVisionCheck then return true end
    if not p.Character then return false end
    return isVisibleFromCamera(p.Character, p.Character)
end

local function getTargetVelocity(targetPlayer)
    if not targetPlayer.Character then return Vector3.zero end
    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.AssemblyLinearVelocity end
    return Vector3.zero
end

local function getNearestPlayerWithSmartAim()
    if not player.Character then return nil end
    local myHRP = player.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local lowestHealth, lowestHealthPlayer = 30, nil
    local validTargets = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            if not shouldTargetPlayer(p) then continue end            local pHRP = p.Character:FindFirstChild("HumanoidRootPart")
            local pHum = p.Character:FindFirstChild("Humanoid")
            if pHRP and pHum and pHum.Health > 0 then
                local dist = (myHRP.Position - pHRP.Position).Magnitude
                if dist < settings.silentAimRange then
                    if not settings.ignoreWall then
                        if not isVisibleFromCamera(p.Character, p.Character) then continue end
                    end
                    local onScreen = isPlayerOnScreen(p.Character)
                    if onScreen or not settings.smartAimVisionOnly then
                        table.insert(validTargets, {player = p, dist = dist, health = pHum.Health})
                        if pHum.Health < lowestHealth then
                            lowestHealth = pHum.Health
                            lowestHealthPlayer = p
                        end
                    end
                end
            end
        end
    end
    table.sort(validTargets, function(a, b) return a.dist < b.dist end)
    if settings.smartAimMode == "Nearest" then
        return #validTargets > 0 and validTargets[1].player or nil
    elseif settings.smartAimMode == "Low health" then
        return lowestHealthPlayer or (#validTargets > 0 and validTargets[1].player or nil)
    elseif settings.smartAimMode == "Prediction" then
        return #validTargets > 0 and validTargets[1].player or nil
    else
        return #validTargets > 0 and validTargets[1].player or nil
    end
end

local function startSmartAimAssist()
    if smartAimAssistConn then smartAimAssistConn:Disconnect() end
    smartAimAssistConn = RunService.Heartbeat:Connect(function()
        if not settings.smartAimAssist then return end
        if settings.aimTarget == "off" then return end
        local targetPlayer = getNearestPlayerWithSmartAim()
        if targetPlayer and targetPlayer.Character then
            local targetPart = (settings.aimTarget == "head" and targetPlayer.Character:FindFirstChild("Head")) or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if targetPart then
                local cam = workspace.CurrentCamera
                local aimPosition = targetPart.Position
                if settings.smartAimMode == "Prediction" then
                    local vel = getTargetVelocity(targetPlayer)
                    aimPosition = aimPosition + (vel * settings.smartAimPrediction)
                end
                local dir = (aimPosition - cam.CFrame.Position).Unit
                cam.CFrame = CFrame.new(cam.CFrame.Position, cam.CFrame.Position + dir)
            end
        end
    end)
end

