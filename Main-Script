local function startVisionCheck()
    if tracerRenderConn then tracerRenderConn:Disconnect() end
    tracerRenderConn = RunService.RenderStepped:Connect(function()
        if not settings.espVisionCheck then return end
        if not player.Character then return end
        local camera = workspace.CurrentCamera
        local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        
        for p, tracer in pairs(espTracers) do
            if not p.Parent or not p.Character then
                pcall(function() tracer:Remove() end)
                espTracers[p] = nil
            end
        end
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
