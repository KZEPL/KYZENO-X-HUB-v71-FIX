local function clearHitboxes()
    for _, hl in pairs(hitboxHighlights) do
        if hl then pcall(function() hl:Destroy() end) end
    end
    hitboxHighlights = {}
    for part, origSize in pairs(hitboxExpandedParts) do
        if part and part.Parent then
            pcall(function() part.Size = origSize end)
        end
    end
    hitboxExpandedParts = {}
end

local function updateHitboxes()
    if not settings.hitboxEnabled then clearHitboxes(); return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            if settings.teamCheck and isAlly(p) then continue end
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp and not hitboxHighlights[p] then
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255, 255, 255)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.3
                hl.OutlineTransparency = 0
                hl.Parent = hrp
                hitboxHighlights[p] = hl
            end
        end
    end
    for p, hl in pairs(hitboxHighlights) do
        if not p.Parent or not p.Character then
            pcall(function() hl:Destroy() end)
            hitboxHighlights[p] = nil
        end
    end
end

local function updateHitboxExpander()
    if not settings.hitboxExpander then
        for part, origSize in pairs(hitboxExpandedParts) do
            if part and part.Parent then
                if not (part.Parent == player.Character) then
                    pcall(function() part.Size = origSize end)
                end
            end
        end
        hitboxExpandedParts = {}
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            if settings.teamCheck and isAlly(p) then continue end
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not hitboxExpandedParts[hrp] then
                    hitboxExpandedParts[hrp] = hrp.Size
                end
                local size = settings.hitboxExpanderSize
                if size > 50 then size = 50 end
                if size < 1 then size = 1 end
                pcall(function()
                    hrp.Size = Vector3.new(size, size, size)
                    hrp.Transparency = 0.5
                end)
            end
        end
    end
    for part, origSize in pairs(hitboxExpandedParts) do
        if not part or not part.Parent then
            hitboxExpandedParts[part] = nil
        end
    end
end

local function updateHitboxExpanderSelf()
    if not settings.hitboxExpanderSelf then
        if player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp and hitboxExpandedParts[hrp] then
                pcall(function() hrp.Size = hitboxExpandedParts[hrp] end)
                hitboxExpandedParts[hrp] = nil
            end
        end
        return
    end
    if player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if not hitboxExpandedParts[hrp] then
                hitboxExpandedParts[hrp] = hrp.Size
            end
            local size = settings.hitboxExpanderSelfSize
            if size < 0.5 then size = 0.5 end
            if size > 3 then size = 3 end
            pcall(function()
                hrp.Size = Vector3.new(size, size, size)
            end)
        end
    end
end

