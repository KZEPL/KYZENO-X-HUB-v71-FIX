-- ============================================================
--  FLING TOUCH (v1 method)
-- ============================================================
local flingActive = false
local flingCoroutine = nil
local flingTouchConn = nil

local function flingLoop()
    local lp = player
    local c, hrp, vel, movel = nil, nil, nil, 0.1
    while flingActive do
        RunService.Heartbeat:Wait()
        c = lp.Character
        hrp = c and c:FindFirstChild("HumanoidRootPart")
        if hrp then
            vel = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = vel * 10000 + Vector3.new(0, 10000, 0)
            RunService.RenderStepped:Wait()
            hrp.AssemblyLinearVelocity = vel
            RunService.Stepped:Wait()
            hrp.AssemblyLinearVelocity = vel + Vector3.new(0, movel, 0)
            movel = -movel
        end
    end
end

local function enableFlingTouch()
    if flingTouchConn then flingTouchConn:Disconnect() end
    if flingCoroutine then flingActive = false; flingCoroutine = nil end
    flingActive = true
    flingCoroutine = coroutine.create(flingLoop)
    coroutine.resume(flingCoroutine)
    flingTouchConn = RunService.Heartbeat:Connect(function()
        if not settings.flingTouch then return end
        local char = player.Character
        if not char then return end
        local myHRP = char:FindFirstChild("HumanoidRootPart")
        local myTool = char:FindFirstChildOfClass("Tool")
        if not myHRP then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                if settings.teamCheck and p.Team == player.Team then continue end
                local pHRP = p.Character:FindFirstChild("HumanoidRootPart")
                if pHRP then
                    local dist = (myHRP.Position - pHRP.Position).Magnitude
                    if dist < 20 then
                        pcall(function()
                            local flingDir = (pHRP.Position - myHRP.Position).Unit
                            pHRP.AssemblyLinearVelocity = flingDir * settings.flingPower + Vector3.new(0, 100, 0)
                        end)
                        if myTool and myTool:FindFirstChild("Handle") then
                            pcall(function()
                                firetouchinterest(myTool.Handle, pHRP, 0)
                                firetouchinterest(myTool.Handle, pHRP, 1)
                            end)
                        end
                    end
                end
            end
        end
    end)
end

local function disableFlingTouch()
    flingActive = false
    if flingCoroutine then flingCoroutine = nil end
    if flingTouchConn then flingTouchConn:Disconnect(); flingTouchConn = nil end
end

