local function startBodyTracers()
    if bodyTracerRenderConn then bodyTracerRenderConn:Disconnect() end
    bodyTracerRenderConn = RunService.RenderStepped:Connect(function()
        if not settings.espTracerLine then
            for _, t in pairs(espBodyTracers) do pcall(function() t:Remove() end) end
            espBodyTracers = {}
            return
        end
        if not player.Character then return end
        local camera = workspace.CurrentCamera
        
        for p, tracers in pairs(espBodyTracers) do
            if not p.Parent or not p.Character then
                for _, t in pairs(tracers) do pcall(function() t:Remove() end) end
                espBodyTracers[p] = nil
            end
        end
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                if settings.teamCheck and isAlly(p) then continue end
                if not isESPVisible(p) then
                    if espBodyTracers[p] then
                        for _, t in pairs(espBodyTracers[p]) do
                            if t then t.Visible = false end
                        end
                    end
                    continue
                end
                
                local head = p.Character:FindFirstChild("Head")
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local leftArm = p.Character:FindFirstChild("Left Arm") or p.Character:FindFirstChild("LeftHand")
                local rightArm = p.Character:FindFirstChild("Right Arm") or p.Character:FindFirstChild("RightHand")
                local leftLeg = p.Character:FindFirstChild("Left Leg") or p.Character:FindFirstChild("LeftFoot")
                local rightLeg = p.Character:FindFirstChild("Right Leg") or p.Character:FindFirstChild("RightFoot")
                
                if head and hrp then
                    local headPos, headOn = camera:WorldToViewportPoint(head.Position)
                    local feetPos, feetOn = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    local leftArmPos, leftArmOn = nil, false
                    local rightArmPos, rightArmOn = nil, false
                    local leftLegPos, leftLegOn = nil, false
                    local rightLegPos, rightLegOn = nil, false
                    
                    if leftArm and leftArm:IsA("BasePart") then
                        leftArmPos, leftArmOn = camera:WorldToViewportPoint(leftArm.Position)
                    end
                    if rightArm and rightArm:IsA("BasePart") then
                        rightArmPos, rightArmOn = camera:WorldToViewportPoint(rightArm.Position)
                    end
                    if leftLeg and leftLeg:IsA("BasePart") then
                        leftLegPos, leftLegOn = camera:WorldToViewportPoint(leftLeg.Position)
                    end
                    if rightLeg and rightLeg:IsA("BasePart") then
                        rightLegPos, rightLegOn = camera:WorldToViewportPoint(rightLeg.Position)
                    end
                    
                    if not espBodyTracers[p] then
                        espBodyTracers[p] = {}
                    end
                    
                    -- Body trace (vertical line) - "+" style
                    if not espBodyTracers[p].body then
                        local tracer = Drawing.new("Line")
                        tracer.Thickness = 2
                        espBodyTracers[p].body = tracer
                    end
                    espBodyTracers[p].body.Visible = (headOn or feetOn)
                    espBodyTracers[p].body.Color = Color3.fromRGB(255, 50, 50)
                    espBodyTracers[p].body.From = Vector2.new(headPos.X, headPos.Y)
                    espBodyTracers[p].body.To = Vector2.new(feetPos.X, feetPos.Y)
                    
                    -- Arm traces ("-" style)
                    if leftArm and leftArmOn then
                        if not espBodyTracers[p].leftArm then
                            local tracer = Drawing.new("Line")
                            tracer.Thickness = 1.5
                            espBodyTracers[p].leftArm = tracer
                        end
                        espBodyTracers[p].leftArm.Visible = true
                        espBodyTracers[p].leftArm.Color = Color3.fromRGB(255, 200, 100)
                        espBodyTracers[p].leftArm.From = Vector2.new(headPos.X + 8, headPos.Y + 10)
                        espBodyTracers[p].leftArm.To = Vector2.new(leftArmPos.X, leftArmPos.Y)
                    elseif espBodyTracers[p].leftArm then
                        espBodyTracers[p].leftArm.Visible = false
                    end
                    
                    if rightArm and rightArmOn then
                        if not espBodyTracers[p].rightArm then
                            local tracer = Drawing.new("Line")
                            tracer.Thickness = 1.5
                            espBodyTracers[p].rightArm = tracer
                        end
                        espBodyTracers[p].rightArm.Visible = true
                        espBodyTracers[p].rightArm.Color = Color3.fromRGB(255, 200, 100)
                        espBodyTracers[p].rightArm.From = Vector2.new(headPos.X - 8, headPos.Y + 10)
                        espBodyTracers[p].rightArm.To = Vector2.new(rightArmPos.X, rightArmPos.Y)
                    elseif espBodyTracers[p].rightArm then
                        espBodyTracers[p].rightArm.Visible = false
                    end
                    
                    -- Leg traces
                    if leftLeg and leftLegOn then
                        if not espBodyTracers[p].leftLeg then
                            local tracer = Drawing.new("Line")
                            tracer.Thickness = 1.5
                            espBodyTracers[p].leftLeg = tracer
                        end
                        espBodyTracers[p].leftLeg.Visible = true
                        espBodyTracers[p].leftLeg.Color = Color3.fromRGB(100, 200, 255)
                        espBodyTracers[p].leftLeg.From = Vector2.new(feetPos.X - 5, feetPos.Y)
                        espBodyTracers[p].leftLeg.To = Vector2.new(leftLegPos.X, leftLegPos.Y)
                    elseif espBodyTracers[p].leftLeg then
                        espBodyTracers[p].leftLeg.Visible = false
                    end
                    
                    if rightLeg and rightLegOn then
                        if not espBodyTracers[p].rightLeg then
                            local tracer = Drawing.new("Line")
                            tracer.Thickness = 1.5
                            espBodyTracers[p].rightLeg = tracer
                        end
                        espBodyTracers[p].rightLeg.Visible = true
                        espBodyTracers[p].rightLeg.Color = Color3.fromRGB(100, 200, 255)
                        espBodyTracers[p].rightLeg.From = Vector2.new(feetPos.X + 5, feetPos.Y)
